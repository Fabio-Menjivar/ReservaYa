@model ReservaYa.Models.Extras.ReservaFechaDisponibleItemVM

@{
    ViewBag.Title = "Crear fecha reservada";
}

<h2>Crear nueva fecha para este espacio</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Selecciona una fecha disponible</label>
        @Html.DropDownList("FechaDisponibleID",
            (List<SelectListItem>)ViewBag.FechasDisponibles,
            "-- Seleccionar --",
            new { @class = "form-control" })
    </div>

    @Html.HiddenFor(x => x.ReservaFechaID)
    @Html.Hidden("EspacioID", ViewBag.EspacioID)

    <button type="submit" class="btn btn-success">Guardar</button>
    @Html.ActionLink("Volver", "Index", new { idEspacio = ViewBag.EspacioID }, new { @class = "btn btn-secondary" })
}
