@model ReservaYa.Models.Extras.EspacioViewModel

@{
    ViewBag.Title = "Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var viewData = new ViewDataDictionary { { "EsEdicion", true } };

}

<h2>Update</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    //Shared / Espacios [formulario]
    @Html.EditorForModel(new { ViewData = viewData })


    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="@Url.Action("Homepage")" class="btn btn-secondary">Cancelar</a>
}

