@model ReservaYa.Models.Extras.EspacioViewModel
@{
    ViewBag.Title = "Crear Espacio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var viewData = new ViewDataDictionary { { "EsEdicion", false } };


}

<h2>Registro para crear Espacios</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.EditorForModel(new { ViewData = viewData }) //Hereda en model al rendereizarse aqui e igual otras propiedades

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a href="@Url.Action("Mostrar")" class="btn btn-secondary">Cancelar</a>
}