<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="~/Content/Uploads/Espacios/Images/icon32.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <title>@ViewBag.Title - ReservaYa</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @{
        // 1. Definir variables de estado de sesión
        int? usuarioId = Session["UsuarioID"] as int?; // Null si no está logueado
        int rolId = (int?)Session["RolID"] ?? 0; // 1: Admin, 2: Cliente, 0: No logueado
    }
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <img src="~/Content/Uploads/Espacios/Images/icon32.png" />
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                              aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav me-auto mb-2 mb-sm-0">

                    @* 🏠 HOME: Visible solo si NO es administrador (rolId != 1) *@
                    @if (rolId != 1)
                    {
                        <li>@Html.ActionLink("Home", "Index", "GestionEspacios", new { area = "" }, new { @class = "nav-link" })</li>
                    }

                    @* 🛠️ Enlaces de Administrador (RolID = 1) *@
                    @if (rolId == 1)
                    {
                        <li>@Html.ActionLink("Panel de Administrador", "Homepage", "GestionEspacios", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Crea tu propio espacio", "Create", "GestionEspacios", new { area = "" }, new { @class = "nav-link" })</li>
                    }

                    @* 🧑‍💻 Enlaces de Cliente (RolID = 2) *@
                    @if (rolId == 2)
                    {
                        <li>@Html.ActionLink("Gestiona tus reservas", "MisReservas", "GestionReservas", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto mb-2 mb-sm-0">
                    @* 🔒 Iniciar Sesión / Registrarse: Visible solo si NO hay usuario logueado *@
                    @if (usuarioId == null)
                    {
                        <li>@Html.ActionLink("Iniciar Sesión", "Login", "Login", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Crear cuenta nueva", "Register", "Login", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                    @* 🚪 Cerrar Sesión: Visible si hay usuario logueado *@
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink($"Cerrar Sesión ({Session["NombreUsuario"]})", "Logout", "Login", new { area = "" }, new { @class = "nav-link" })
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Perfil", "Cuenta")">Mi Perfil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
    </div>

    <footer class="bg-dark text-light pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row">

                <div class="col-md-4 mb-4">
                    <h3 class="fw-bold text-uppercase">DEVELO₱ERS</h3>
                    <p class="text-muted">Reserva Inteligente, Espacios Eficientes, tales como Salones educativos y Laboratorios Informáticos</p>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold">Enlaces</h5>
                    <ul class="list-unstyled">
                        @* HOME: Visible solo si NO es administrador (rolId != 1) *@
                        @if (rolId != 1)
                        {
                            <li>@Html.ActionLink("Home", "Index", "GestionEspacios", new { area = "" }, new { @class = "nav-link" })</li>
                        }

                        @* Lógica de Admin en el Footer *@
                        @if (rolId == 1)
                        {
                            <li>@Html.ActionLink("Panel de Administrador", "Homepage", "GestionEspacios", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Crea tu propio espacio", "Create", "GestionEspacios", new { area = "" }, new { @class = "nav-link" })</li>
                        }

                        @* Lógica de Cliente en el Footer *@
                        @if (rolId == 2)
                        {
                            <li>@Html.ActionLink("Gestiona tus reservas", "MisReservas", "GestionReservas", new { area = "" }, new { @class = "nav-link" })</li>
                        }

                    </ul>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold">Contáctanos</h5>
                    <p class="mb-1"><i class="bi bi-envelope"></i> reservaya34@gmail.com</p>
                    <p class="mb-1"><i class="bi bi-telephone"></i>+503 6023-8774</p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="https://www.facebook.com/profile.php?id=61582322333145" class="text-light fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="https://x.com/ReservaYa34" class="text-light fs-5"><i class="bi bi-twitter"></i></a>

                    </div>
                </div>
            </div>

            <hr class="border-secondary">
            <div class="text-center text-muted">
                <small>&copy; 2025 DEVELO₱ERS. Todos los derechos reservados.</small>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>